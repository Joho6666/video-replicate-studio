# 复刻工作台配置（复制为 .env.local 后填写；.env.local 不进 git）
STUDIO_PORT=3300

# DeepSeek：看关键帧、写分镜与 LibTV 提示词（只花 token，不花视频费）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# TikHub：抓 TikTok / Instagram；抖音在 MediaCrawler 失败时的备用来源（按调用计费）
TIKHUB_API_KEY=
TIKHUB_BASE_URL=https://api.tikhub.dev

# 可选：MiniMax H3 一键出片（「H3 出片」页的付费按钮）。必须是按量付费的 Key；
# 套餐类 sk-cp- Key 调 H3 会报 402「insufficient balance (1008)」。海外账号把地址改成 https://api.minimax.io
# MINIMAX_API_KEY=
# MINIMAX_BASE_URL=https://api.minimaxi.com

# 可选：MOSI（模思智能）语音。拆解时自动转写原片口播 / 对白（说话人分离，¥2 / 小时），
# 并在「带货文案」页把口播脚本按每段时长配成语音（¥2 / 万字）。音色来自你在 platform.mosi.cn 的账号。
# MOSS_API_KEY=

# 可选：复用另一个项目的 .env.local（这里没填的键会从那里读取）
# AVD_ENV_FILE=C:\path\to\ai-video-director\.env.local

# 可选：FFmpeg / FFprobe 路径（默认找 PATH；也可指向 ffmpeg-static）
# FFMPEG_PATH=
# FFPROBE_PATH=

# 可选：换人后的合成（RVM 抠图 + RIFE 补帧 + Real-ESRGAN 放大），都在本机显卡 / CPU 上跑，不花接口费
# PYTHON_PATH=            # 需要装 opencv-python numpy onnxruntime
# RIFE_PATH=D:esearch	oolsifeife-ncnn-vulkan.exe
# REALESRGAN_PATH=D:esearch	oolsealesrganealesrgan-ncnn-vulkan.exe
# RVM_MODEL=D:esearch	oolsvm_mobilenetv3_fp32.onnx

# 分析窗口：长视频只拆前 N 秒
ANALYZE_MAX_SEC=60

# 可选：外网代理（Node 默认不走系统代理），例如 Clash
# STUDIO_PROXY=http://127.0.0.1:7890
