# 复刻工作台配置（复制为 .env.local 后填写；.env.local 不进 git）
STUDIO_PORT=3300

# DeepSeek：看关键帧、写分镜与 LibTV 提示词（只花 token，不花视频费）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# TikHub：抓 TikTok / Instagram；抖音在 MediaCrawler 失败时的备用来源（按调用计费）
TIKHUB_API_KEY=
TIKHUB_BASE_URL=https://api.tikhub.io

# 可选：复用另一个项目的 .env.local（这里没填的键会从那里读取）
# AVD_ENV_FILE=C:\path\to\ai-video-director\.env.local

# 可选：FFmpeg / FFprobe 路径（默认找 PATH；也可指向 ffmpeg-static）
# FFMPEG_PATH=
# FFPROBE_PATH=

# 分析窗口：长视频只拆前 N 秒
ANALYZE_MAX_SEC=60
